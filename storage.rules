rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function userData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return request.auth != null && userData().role == 'ADMIN';
    }

    // Meme regle que cote Firestore : statut ACTIVE et adhesion non expiree.
    function isActiveMember() {
      return request.auth != null &&
             userData().membershipStatus == 'ACTIVE' &&
             (!('membershipExpiry' in userData()) || userData().membershipExpiry > request.time);
    }

    function isImage(maxSizeMb) {
      return request.resource.contentType.matches('image/.*') &&
             request.resource.size < maxSizeMb * 1024 * 1024;
    }

    // Visuels des ateliers et evenements : publics en lecture, admin en ecriture.
    match /workshops/{imageId} {
      allow read: if true;
      allow create, update: if isAdmin() && isImage(5);
      allow delete: if isAdmin();
    }

    match /events/{imageId} {
      allow read: if true;
      allow create, update: if isAdmin() && isImage(5);
      allow delete: if isAdmin();
    }

    // Galerie participative : tout utilisateur connecte peut deposer une photo.
    // La limite de 5 Mo et le type image sont desormais verifies cote serveur,
    // et plus seulement dans le composant d'upload.
    match /moments/{imageId} {
      allow read: if true;
      allow create: if request.auth != null && isImage(5);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Comptes rendus d'AG : reserves aux adherents a jour.
    // Important : l'application doit les telecharger via le SDK (getBlob),
    // pas via une URL getDownloadURL, car une telle URL porte un jeton
    // d'acces qui contourne ces regles.
    match /ag-reports/{allPaths=**} {
      allow read: if isActiveMember() || isAdmin();
      allow create, update: if isAdmin() &&
                              request.resource.contentType == 'application/pdf' &&
                              request.resource.size < 20 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // Tout le reste est refuse par defaut.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
